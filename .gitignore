
import requests
import time

# --- CONFIG ---
# Yaha apna TEST endpoint daal, kabhi bhi real user ka endpoint nahi
URL = "https://example.com/api/test-otp"
MAX_ATTEMPTS = 10  # Sirf 10 request, brute-force nahi
DELAY = 1  # 1 sec gap

print(f"[*] Testing Rate Limit on: {URL}")
print(f"[*] Total attempts: {MAX_ATTEMPTS}\n")

blocked = False

for i in range(1, MAX_ATTEMPTS + 1):
    try:
        # Fake data - real OTP guess nahi kar rahe
        data = {"otp": "000000", "test": "rate-limit-check"}
        r = requests.post(URL, json=data, timeout=5)

        print(f"Attempt {i}: Status {r.status_code}")

        if r.status_code == 429:
            print(f"\n[✓] GOOD: Rate limit working! Blocked at attempt {i}")
            blocked = True
            break
        elif r.status_code in [403, 401]:
            print(f"\n[✓] GOOD: Access blocked with {r.status_code}")
            blocked = True
            break
        
        time.sleep(DELAY)

    except Exception as e:
        print(f"Error: {e}")
        break

if not blocked:
    print("\n[!] FINDING: No rate limit after 10 attempts!")
    print("This can be reported as: 'Missing Rate Limiting on OTP Endpoint'")
else:
    print("\n[INFO] Endpoint is protected.")
